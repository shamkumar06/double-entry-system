generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}


enum Role {
  ADMIN
  VIEWER
}

enum AccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum EntryType {
  DEBIT
  CREDIT
}

enum CashierRole {
  GUIDE
  STUDENT
  PROCURING_STUDENT
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String?
  role         Role     @default(VIEWER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([email])
  @@map("users")
}

model SystemSettings {
  id                 String    @id @default(uuid())
  baseCurrency       String    @default("INR")
  exchangeRateApiKey String?
  cachedRates        Json?
  ratesCachedAt      DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@map("system_settings")
}

model Project {
  id          String   @id @default(uuid())
  name        String   @unique
  description String?
  totalFunds  Decimal  @default(0) @db.Decimal(15, 2)
  logoUrl     String?
  mainCashierName String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  phases       Phase[]
  transactions Transaction[]
  procurements ProcurementItem[]
  members      ProjectMember[]

  @@index([name])
  @@map("projects")
}

model Phase {
  id               String   @id @default(uuid())
  projectId        String
  name             String
  description      String?
  estimatedBudget  Decimal  @default(0) @db.Decimal(15, 2)
  receivedAmount   Decimal  @default(0) @db.Decimal(15, 2)
  receivedFrom     String?
  receivedTo       String?
  paymentMode      String?
  reference        String?
  requestLetterUrl String?
  returnedAmount   Decimal  @default(0) @db.Decimal(15, 2)
  reallocatedAmount Decimal  @default(0) @db.Decimal(15, 2)
  isSettled        Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  project      Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  transactions Transaction[]
  procurements ProcurementItem[]

  @@unique([projectId, name])
  @@index([projectId])
  @@map("phases")
}

model AccountCategory {
  id          String      @id @default(uuid())
  code        Int         @unique
  name        String      @unique
  type        AccountType
  description String?
  isSystem    Boolean     @default(false)
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  transactionLines TransactionLine[]

  @@index([type])
  @@index([code])
  @@map("account_categories")
}

model Transaction {
  id            String    @id @default(uuid())
  projectId     String
  phaseId       String?
  cashierName   String?
  date          DateTime
  description   String
  fromEntity    String?
  toEntity      String?
  paymentMode   String?
  reference     String?
  attachmentUrl     String?
  gpayScreenshotUrl String?
  materialImageUrl   String?
  cgst          Decimal?  @db.Decimal(15, 2)
  sgst          Decimal?  @db.Decimal(15, 2)
  igst          Decimal?  @db.Decimal(15, 2)
  discount      Decimal?  @db.Decimal(15, 2)
  actualAmount  Decimal?  @db.Decimal(15, 2)
  isDeleted     Boolean   @default(false)
  deletedAt     DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  project Project           @relation(fields: [projectId], references: [id])
  phase   Phase?            @relation(fields: [phaseId], references: [id])
  lines   TransactionLine[]

  @@index([projectId])
  @@index([phaseId])
  @@index([isDeleted])
  @@index([date])
  @@map("transactions")
}

model TransactionLine {
  id            String    @id @default(uuid())
  transactionId String
  accountId     String
  type          EntryType
  amount        Decimal   @db.Decimal(15, 2)
  createdAt     DateTime  @default(now())

  transaction Transaction     @relation(fields: [transactionId], references: [id], onDelete: Cascade)
  account     AccountCategory @relation(fields: [accountId], references: [id])

  @@index([transactionId])
  @@index([accountId])
  @@map("transaction_lines")
}

enum ProcurementStatus {
  PLANNING
  ORDERED
  DELIVERED
  CANCELLED
}

model ProcurementItem {
  id            String            @id @default(uuid())
  projectId     String
  phaseId       String?
  materialName  String
  vendorName    String?
  quantity      Decimal           @db.Decimal(15, 2)
  unit          String            // e.g., "bags", "tons", "units", "cft"
  estimatedRate Decimal           @db.Decimal(15, 2)
  actualRate    Decimal?          @db.Decimal(15, 2)
  cgst          Decimal?          @db.Decimal(15, 2)
  sgst          Decimal?          @db.Decimal(15, 2)
  igst          Decimal?          @db.Decimal(15, 2)
  discount      Decimal?          @db.Decimal(15, 2)
  status        ProcurementStatus @default(PLANNING)
  driveFileId   String?           // Google Drive file ID
  driveViewUrl  String?           // Google Drive public URL
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  project       Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  phase         Phase?            @relation(fields: [phaseId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([phaseId])
  @@map("procurement_items")
}

model Notepad {
  id        String   @id @default(uuid())
  projectId String
  phaseId   String?
  content   String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, phaseId])
  @@map("notepads")
}

model ProjectMember {
  id              String          @id @default(uuid())
  projectId       String
  name            String
  role            CashierRole     @default(STUDENT)
  phone           String?
  isActive        Boolean         @default(true)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  parentMemberId  String?

  parentMember    ProjectMember?  @relation("MemberToMember", fields: [parentMemberId], references: [id], onDelete: SetNull)
  childrenMembers ProjectMember[] @relation("MemberToMember")
  project         Project         @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, name])
  @@index([projectId])
  @@map("project_members")
}
